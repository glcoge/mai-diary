{
  "manifest_version": 2,
  "id": "glcoge.mai-diary",
  "version": "1.3.0",
  "name": "MaiBot 日记插件",
  "description": "每天 04:00 自动总结上一日 04:00 起的聊天记录，08:00 通过 ntfy 推送至手机，本地落盘 Markdown + JSON。",
  "author": {
    "name": "glcoge",
    "url": "https://github.com/glcoge"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/glcoge/mai-diary",
    "issues": "https://github.com/glcoge/mai-diary/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.7.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "config.get",
    "llm.generate",
    "message.get_by_time",
    "message.get_by_time_in_chat",
    "chat.get_stream_by_group_id",
    "chat.get_stream_by_user_id",
    "api.call",
    "api.list"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
